# IVI Analysis configuration. Copy to .env (git-ignored) and fill in.
# Every setting is a VOE_* environment variable; the .env file is optional.
# Only VOE_* names are read from this file, and only when it is private
# (chmod 600 .env). A .env in the directory you run from is ignored unless
# VOE_DOTENV_CWD=1.

# --- Required ---------------------------------------------------------------
# The SEC requires every automated client to identify itself with a name and a
# monitored contact email (https://www.sec.gov/os/accessing-edgar-data).
# IVI Analysis refuses to contact the SEC until this is set.
VOE_SEC_USER_AGENT="Your Name you@yourdomain.com"

# --- Where data lives -------------------------------------------------------
# SQLite database, SEC caches and generated reports. Defaults to ./data.
# VOE_DATA_DIR=./data

# --- Prices (optional) ------------------------------------------------------
# "auto" (default): EODHD when VOE_EODHD_APIKEY is set, then Yahoo Finance
# (free, no key) and Stooq (needs VOE_STOOQ_APIKEY). "disabled" turns live
# prices off; "yahoo", "stooq" or "eodhd" pin one source.
# VOE_PRICE_PROVIDER=auto
# VOE_EODHD_APIKEY=
# VOE_STOOQ_APIKEY=

# --- AI analyst (optional) --------------------------------------------------
# Fundamentals and valuation run without any AI provider. Set one of these to
# enable analyst memos, evidence adjudication and synthesis.
# VOE_LLM_PROVIDER=anthropic        # anthropic | openai | deepseek | disabled
# VOE_ANTHROPIC_API_KEY=
# VOE_OPENAI_API_KEY=

# --- Network ----------------------------------------------------------------
# The single switch for all outbound requests. "disabled" = cache-only.
# VOE_NET_PROVIDER=enabled
# SEC requests per second (the SEC's published ceiling is 10).
# VOE_SEC_RPS=5
